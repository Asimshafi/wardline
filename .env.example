# Wardline environment variables — COPY to .env.local and fill in.
# .env.local is git-ignored (spec §5.7). Never commit real values. Never expose
# the service-role key or bot token to the browser (no NEXT_PUBLIC_ prefix on them).

# ── Public (safe to expose to the browser) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Client-side hint only: pre-fills the login placeholder and shows a "use your
# college email" warning before submit. NOT a security control — the real domain
# restriction is enforced in Supabase Auth (see below). Leave blank to disable the hint.
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAIN=college.edu

# ── Server-only secrets (never NEXT_PUBLIC_, never in client code) ───────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # seed script + Edge Functions only
TELEGRAM_BOT_TOKEN=123456:your-botfather-token          # Edge Function secret (also set via `supabase secrets set`)

# ── Seed script input ────────────────────────────────────────────────────────
TAXONOMY_CSV=../Downloads/wardline_master_taxonomy.csv  # path passed to scripts/seed-taxonomy.mjs

# ── Auth ───────────────────────────────────────────────────────────────────────
# Signup is restricted to your college domain in Supabase Dashboard → Authentication
# → Providers (allowed email domains). Not an env var — set it there (§5.4, §9.7).
